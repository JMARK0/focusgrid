<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose owns all theming (see ui/theme/Theme.kt). This entry only
         satisfies the manifest/launcher requirement for a system theme
         and controls the window background before Compose draws. -->
    <style name="Theme.FocusGrid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/white</item>
    </style>
</resources>
